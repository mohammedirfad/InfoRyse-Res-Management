# ── Database (Supabase) ───────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Connect → Connection string → URI
# Use Session pooler (port 5432 on pooler host) — NOT Transaction pooler (6543)
# NOTE: If your password contains special chars (@, #, etc.), percent-encode them
#       e.g. Zxcvbnm@001 → Zxcvbnm%40001
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Random secret for signing JWT session cookies — 32+ characters
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ── App URL ──────────────────────────────────────────────────────────────────
# Used for QR code URL generation — change to your production domain when deployed
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email OTP (optional) ─────────────────────────────────────────────────────
# Resend.com free tier: 3,000 emails/month
# If empty, dev mode shows OTP directly on-screen (never do this in production!)
RESEND_API_KEY=""

# ── Environment ──────────────────────────────────────────────────────────────
NODE_ENV="development"
