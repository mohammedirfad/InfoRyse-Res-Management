# ── Database (Supabase) ───────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Connect → Connection string → URI
# Runtime on Vercel/serverless: Supavisor Transaction pooler (port 6543).
# Copy the Transaction pooler URI from Supabase Connect; append these parameters.
# Keep connection_limit=1 per function instance to avoid exhausting DB connections.
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=15&connect_timeout=15"
# Migrations: use the Supabase direct connection (or Session pooler on port 5432).
DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres"
# NOTE: If your password contains special chars (@, #, etc.), percent-encode them.

# ── Auth ─────────────────────────────────────────────────────────────────────
# Random secret for signing JWT session cookies — 32+ characters
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ── App URL ──────────────────────────────────────────────────────────────────
# Used for QR code URL generation — change to your production domain when deployed
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email OTP (optional) ─────────────────────────────────────────────────────
# Resend.com free tier: 3,000 emails/month
# If empty, dev mode shows OTP directly on-screen (never do this in production!)
RESEND_API_KEY=""

# ── Cloudflare R2 Image Storage ───────────────────────────────────────────────
# Get from: dash.cloudflare.com → R2 → Manage R2 API tokens
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="inforyse-images"
# Get from: R2 bucket → Settings → Public bucket URL (enable public access first)
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"

