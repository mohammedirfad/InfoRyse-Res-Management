generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  OWNER
  STAFF
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum ServiceRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Restaurant {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       String
  isActive   Boolean  @default(true)
  openNow    Boolean  @default(true)
  latitude   Float?
  longitude  Float?
  taxName    String?  @default("GST")
  taxPercent Float?   @default(5.0)
  additionalTaxes Json?
  logoUrl          String?
  discountActive   Boolean  @default(false)
  discountPercent  Float?   @default(0.0)
  discountName     String?  @default("Special Offer")
  ownerName        String?
  contactEmail     String?
  contactPhone     String?
  upiPaymentId String?
  location         String?
  plan             String?  @default("Pro")
  nextOrderNumber  Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users         User[]
  categories    Category[]
  menuItems     MenuItem[]
  tables        Table[]
  orders        Order[]
  tableSessions TableSession[]
  bills         Bill[]
  serviceRequests ServiceRequest[]

  @@index([slug])
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String?
  phone              String?
  passwordHash       String
  role               Role
  mustChangePassword Boolean  @default(false)
  restaurantId       String? // null for SUPER_ADMIN
  restaurant         Restaurant? @relation(fields: [restaurantId], references: [id])
  createdAt          DateTime @default(now())

  @@index([restaurantId])
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  purpose   String // "LOGIN_2FA"
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id           String   @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  position     Int      @default(0)
  isActive     Boolean  @default(true)
  deletedAt    DateTime?

  menuItems MenuItem[]

  @@index([restaurantId])
  @@index([restaurantId, position])
}

model MenuItem {
  id           String   @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  name         String
  description  String?
  priceCents   Int      // store money as integer (paise)
  imageUrl     String?
  isVeg        Boolean  @default(true)
  isAvailable  Boolean  @default(true)
  isBestseller Boolean  @default(false)
  isPopular    Boolean  @default(false)
  isChefsPick  Boolean  @default(false)
  isTodaySpecial Boolean @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, isAvailable])
  @@index([categoryId, deletedAt, createdAt])
}

model Table {
  id           String      @id @default(uuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  label        String
  section      String?
  capacity     Int?
  status       TableStatus @default(AVAILABLE)
  qrToken      String      @unique
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())

  orders       Order[]
  sessions     TableSession[]
  bills        Bill[]
  serviceRequests ServiceRequest[]

  @@index([restaurantId])
  @@unique([restaurantId, label])
}

/// Tracks a group of orders placed at one table in one sitting.
/// All orders from the same QR scan session attach to the same TableSession.
/// Finalized = staff has generated the final bill; Paid = payment collected.
model TableSession {
  id             String    @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  tableId        String
  table          Table     @relation(fields: [tableId], references: [id])
  status         String    @default("OPEN")
  finalizedAt    DateTime?
  paidAt         DateTime?
  billRequestedAt DateTime?
  createdAt      DateTime  @default(now())

  orders         Order[]
  serviceRequests ServiceRequest[]

  @@index([restaurantId, tableId, status])
}

model ServiceRequest {
  id             String               @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant           @relation(fields: [restaurantId], references: [id])
  tableId        String
  table          Table                @relation(fields: [tableId], references: [id])
  tableSessionId String?
  tableSession   TableSession?        @relation(fields: [tableSessionId], references: [id])
  tableLabel     String
  requests       String[]
  custom         String?
  status         ServiceRequestStatus @default(PENDING)
  handledBy      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([restaurantId, status, createdAt])
  @@index([tableId, createdAt])
  @@index([tableSessionId])
}

model Order {
  id             String      @id @default(uuid())
  restaurantId   String
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id])
  tableId        String?
  table          Table?      @relation(fields: [tableId], references: [id])
  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id])
  orderNumber    Int      @default(dbgenerated("nextval('\"GlobalOrderNumberSequence\"'::regclass)"))
  customerName   String?
  customerPhone  String?
  status         OrderStatus @default(NEW)
  subtotalCents  Int
  totalCents     Int
  idempotencyKey String      @unique
  notes          String?
  orderType      String?
  paymentMethod  String?
  customerEmail  String?
  createdByStaff String?
  createdAt      DateTime    @default(now())

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]

  @@index([restaurantId, status, createdAt])
  @@index([tableSessionId])
  @@unique([restaurantId, orderNumber])
}

model OrderItem {
  id         String  @id @default(uuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id])
  menuItemId String?
  nameSnapshot  String // frozen at order time — never follows later menu edits
  priceCentsSnapshot Int
  quantity   Int
  servedQuantity Int @default(0)
  cancelledQuantity Int @default(0)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  changedBy String?     // userId, null if system
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Bill {
  id              String      @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id])
  tableId         String?
  table           Table?      @relation(fields: [tableId], references: [id])
  tableSessionId  String?
  billNumber      Int
  tableLabel      String
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  orderCount      Int         @default(1)
  subtotalCents   Int
  discountCents   Int         @default(0)
  discountPercent Float       @default(0.0)
  discountName    String?
  taxCents        Int         @default(0)
  taxPercent      Float       @default(5.0)
  taxName         String      @default("GST")
  taxBreakdown    Json?
  packingCents    Int         @default(0)
  totalCents      Int
  paymentMethod   String      @default("CASH") // CASH, UPI, CARD, OTHER
  paymentStatus   String      @default("PAID") // PAID, PENDING
  paidAt          DateTime?
  itemsJson       String      // JSON string of [{ name, quantity, unitPrice, subtotal }]
  shareToken      String?     @unique
  createdAt       DateTime    @default(now())

  @@index([restaurantId, createdAt])
  @@index([restaurantId, tableSessionId])
  @@unique([restaurantId, billNumber])
}


